# Environment Configuration Template
# Copy this file to .env and fill in your values

# Application
APP_NAME=MY Agent
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# LLM Configuration
API_KEY=
BASE_URL=
DEFAULT_MODEL=gpt-4-turbo-128k
QPS_LIMIT=20
TIMEOUT=60.0

# Ollama LLM Configuration
OLLAMA_API_KEY=test
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_DEFAULT_MODEL=gemma2:9b
OLLAMA_TIMEOUT=600.0

# Vector Store
VECTOR_STORE_PATH=./data/vector_store

# Retrieval
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5

# TTS Configuration
TTS_ENABLED=false
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_TIMEOUT=10.0

# Chat Configuration
CHAT_MAX_TURNS=20

# Prompt Configuration
PROMPT_DIR=./prompts
DEFAULT_PROMPT=rem

# Tool System Configuration
TOOL_FILE_WHITELIST=["./"]
ENABLE_TOOLS=true

# Toolbox Configuration
TOOL_ALLOWED_EXTENSIONS=[".py", ".json", ".toml", ".yaml", ".yml", ".md", ".txt"]